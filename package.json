{
  "name": "smart-supermarket",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Supermarket - Self-Checkout & Store Operations System (MERN Stack)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run start --prefix backend",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "tunnel": "npx localtunnel --port 5173",
    "tunnel:subdomain": "npx localtunnel --port 5173 --subdomain gosmart-supermarket",
    "tunnel:cloud": "npx untun@latest tunnel --port 5173"
  },
  "keywords": [
    "supermarket",
    "self-checkout",
    "mern",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
